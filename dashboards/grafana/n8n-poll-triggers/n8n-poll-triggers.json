{
  "uid": "n8n-poll-triggers",
  "title": "n8n Poll Triggers",
  "tags": [
    "n8n",
    "poll-trigger"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "auto",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "node_type",
        "label": "Node Type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(n8n_poll_trigger_duration_seconds_count, node_type)",
          "refId": "StandardVariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Main instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(n8n_poll_trigger_duration_seconds_count, instance)",
          "refId": "StandardVariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Poll Success Rate",
      "description": "Share of poll ticks that finished without throwing, over the range.\n\nWhen bad: below ~95% means poll() calls are erroring — check Errors by Kind. One node type is a node/credential bug, all types point to network or the source systems.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "min": 0,
          "max": 1
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(n8n_poll_trigger_duration_seconds_count{node_type=~\"$node_type\", status=\"success\", instance=~\"$instance\"}[$__range])) / clamp_min(sum(increase(n8n_poll_trigger_duration_seconds_count{node_type=~\"$node_type\", instance=~\"$instance\"}[$__range])), 1)",
          "legendFormat": "Poll Success Rate"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Poll Rate",
      "description": "Poll ticks per second, across all mains.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 2
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(n8n_poll_trigger_duration_seconds_count{node_type=~\"$node_type\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "Poll Rate"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Overlapping Ticks (range)",
      "description": "Ticks that started while another tick for the same node was still in flight in the same process, over the range.\n\nWhen bad: any overlap means a poll runs longer than its interval — check Poll Duration p99 for that node type and consider a longer interval or poll timeout.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(n8n_poll_trigger_overlapping_ticks_total{node_type=~\"$node_type\", instance=~\"$instance\"}[$__range]))",
          "legendFormat": "Overlapping Ticks (range)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Fence Rejections (range)",
      "description": "Cursor writes rejected by the scheduler-lease fence over the range — a poll losing the race against a reclaimed lease. No node_type label; only the instance filter applies.\n\nWhen bad: each rejection is a prevented duplicate — expected occasionally under lease churn. A sustained rise means mains are losing leases mid-poll; check Duplicate-Risk Signals and main health.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(n8n_poll_trigger_cursor_commits_total{result=\"fence_rejected\", instance=~\"$instance\"}[$__range]))",
          "legendFormat": "Fence Rejections (range)"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Poll Throughput & Outcomes",
      "description": "Poll ticks per second by status; the stack height is overall poll throughput. Filter by node type with the variable above.\n\nWhen bad: error share rising — check Errors by Kind and the Per-Node-Type Breakdown row to isolate the failing node type.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "spanNulls": false,
            "showPoints": "auto",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(n8n_poll_trigger_duration_seconds_count{node_type=~\"$node_type\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Poll Duration — p50 / p90 / p99",
      "description": "Duration of the poll() call itself, from the shared choke point of the cron and durable paths. Baseline for tuning the poll-timeout default.\n\nWhen bad: p99 approaching the poll interval causes overlapping ticks; p99 diverging while p50 stays low means one source system is slow — compare by node type.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(n8n_poll_trigger_duration_seconds_bucket{node_type=~\"$node_type\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.9, sum by (le) (rate(n8n_poll_trigger_duration_seconds_bucket{node_type=~\"$node_type\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(n8n_poll_trigger_duration_seconds_bucket{node_type=~\"$node_type\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Errors by Kind",
      "description": "Poll ticks that threw, per second, classified from the source's HTTP status: auth (401/403), rate_limited (429), or thrown (anything else).\n\nWhen bad: auth means a broken credential — permanent until fixed, disable or re-auth the workflow. rate_limited means the interval is too aggressive for the source. thrown is transient or a node bug — check the logs.",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "auth"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rate_limited"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "thrown"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(n8n_poll_trigger_errors_total{node_type=~\"$node_type\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Duplicate-Risk Signals — Overlap, Lease Loss & Fence Rejections",
      "description": "The three signals that measure the residual-duplicate risk. Overlapping ticks: same-process overlap. Lease lost: a handler finished after its lease was reclaimed (cross-main overlap window). Fence rejected: a cursor write from such a handler was blocked.\n\nWhen bad: lease losses without matching fence rejections are the unprotected window — the data that decides whether cross-process cursor fencing is worth closing now.",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Overlapping ticks"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Lease lost"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fence rejected"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(n8n_poll_trigger_overlapping_ticks_total{node_type=~\"$node_type\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "Overlapping ticks"
        },
        {
          "refId": "B",
          "expr": "sum(rate(n8n_scheduler_tasks_lease_lost_total{task_type=\"workflow:poll-trigger\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "Lease lost"
        },
        {
          "refId": "C",
          "expr": "sum(rate(n8n_poll_trigger_cursor_commits_total{result=\"fence_rejected\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "Fence rejected"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Cursor Commit Outcomes",
      "description": "Poll-cursor commits per second by result. with_execution commits the cursor and the execution in one transaction; cursor_only advances the cursor without new items. No node_type label.\n\nWhen bad: failures mean the cursor transaction is not committing (DB errors, contention) — polls will re-see items. Fence rejections are prevented duplicates; see Duplicate-Risk Signals.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "spanNulls": false,
            "showPoints": "auto",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fence_rejected"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failure"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(n8n_poll_trigger_cursor_commits_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Cursor Commit Latency — p50 / p99 by Operation",
      "description": "Latency of poll-cursor commits by operation. with_execution includes the execution insert, so it is expected to be slower than cursor_only. No node_type label.\n\nWhen bad: rising latency means DB pressure on the poller-state table — it delays the next tick and widens the overlap window.",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, operation) (rate(n8n_poll_trigger_cursor_commit_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{operation}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, operation) (rate(n8n_poll_trigger_cursor_commit_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{operation}} p99"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Poll Dispatch Lag — p50 / p90 / p99 (durable path)",
      "description": "Delay from a poll task becoming due to being dispatched, for durable-scheduler poll jobs only (n8n_scheduler_dispatch_lag_seconds filtered to task_type=\"workflow:poll-trigger\"). Requires N8N_METRICS_INCLUDE_SCHEDULER_METRICS. Empty on the legacy cron path.\n\nWhen bad: p99 diverging while poll duration stays flat means the scheduler, not the polls, is behind — check the n8n Durable Scheduler dashboard.",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(n8n_scheduler_dispatch_lag_seconds_bucket{task_type=\"workflow:poll-trigger\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.9, sum by (le) (rate(n8n_scheduler_dispatch_lag_seconds_bucket{task_type=\"workflow:poll-trigger\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(n8n_scheduler_dispatch_lag_seconds_bucket{task_type=\"workflow:poll-trigger\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "collapsed": true,
      "title": "Per-Node-Type Breakdown (which poll node is misbehaving?)",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 21,
          "type": "timeseries",
          "title": "Poll Rate by Node Type",
          "description": "Poll ticks per second by node type. A node type flat at zero has stopped polling.\n\nWhen bad: a single diverging node type points to that node's source system or implementation — not to n8n infra.",
          "gridPos": {
            "x": 0,
            "y": 41,
            "w": 12,
            "h": 9
          },
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "ops",
              "min": 0,
              "custom": {
                "lineWidth": 2,
                "fillOpacity": 10,
                "spanNulls": false,
                "showPoints": "auto"
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "showLegend": true,
              "calcs": [
                "mean",
                "max"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (node_type) (rate(n8n_poll_trigger_duration_seconds_count{node_type=~\"$node_type\", instance=~\"$instance\"}[$__rate_interval]))",
