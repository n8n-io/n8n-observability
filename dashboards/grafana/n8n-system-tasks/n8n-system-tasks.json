            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "histogram_quantile(0.5, sum by (le) (rate(n8n_scheduler_dispatch_lag_seconds_bucket{task_type=~\"system:.*\", instance=~\"$instance\"}[$__rate_interval])))",
              "legendFormat": "p50"
            },
            {
              "refId": "B",
              "expr": "histogram_quantile(0.99, sum by (le) (rate(n8n_scheduler_dispatch_lag_seconds_bucket{task_type=~\"system:.*\", instance=~\"$instance\"}[$__rate_interval])))",
              "legendFormat": "p99"
