                    }
                  }
                ]
              }
            ]
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (result) (rate(n8n_scheduler_tasks_completed_total{task_type=~\"system:.*\", instance=~\"$instance\"}[$__rate_interval]))",
              "legendFormat": "{{result}}"
            }
          ]
        },
        {
          "id": 23,
          "type": "timeseries",
          "title": "Durable Scheduler \u2014 System Task Dispatch Lag p50 / p99",
          "description": "How late the durable scheduler starts a task, measured from the moment its occurrence was due. Needs `N8N_METRICS_INCLUDE_SCHEDULER_METRICS=true`.\n\nEmpty is the expected reading today, because no system task is durable yet.\n\nWhen bad: p99 rising while p50 stays low means some occurrences are stuck on lease contention or database locks. Open the Durable Scheduler dashboard and compare with the other task types.",
          "gridPos": {
            "x": 16,
            "y": 41,
            "w": 8,
            "h": 9
          },
          "datasource": {
