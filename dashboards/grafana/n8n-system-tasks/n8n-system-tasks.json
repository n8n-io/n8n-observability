{
  "uid": "n8n-system-tasks",
  "title": "n8n System Tasks",
  "description": "Is every n8n system task running? Late or failing tasks show in red.",
  "tags": [
    "n8n",
    "system-tasks"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "n8n Durable Scheduler",
      "type": "dashboards",
      "tags": [
        "scheduler"
      ],
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "tooltip": "The scheduler that runs durable system tasks",
      "url": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "task",
        "label": "System task",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(n8n_system_task_info, task)",
          "refId": "StandardVariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Main instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(n8n_system_task_info, instance)",
          "refId": "StandardVariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Late Tasks",
      "description": "Tasks that stopped running. A task is late when its last success is older than two of its intervals, so it shows here about one interval after the first missed run. A task with no success reported in the last 2 days is also late.\n\nBad when: above zero. Find the task in the table below.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count((((time() - max by (task) (max_over_time(n8n_system_task_last_success_timestamp_seconds{task=~\"$task\", instance=~\"$instance\"}[2d]))) / max by (task) (n8n_system_task_interval_seconds{task=~\"$task\", instance=~\"$instance\"})) > 2) or on (task) (max by (task) (n8n_system_task_info{task=~\"$task\", instance=~\"$instance\"}) unless on (task) max by (task) (max_over_time(n8n_system_task_last_success_timestamp_seconds{task=~\"$task\", instance=~\"$instance\"}[2d])))) or vector(0)",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unscheduled Tasks",
      "description": "Tasks that n8n could not schedule. A timer task stays stopped until a main restarts. A durable task counts here when its stored job is disabled, quarantined or missing.\n\nBad when: above zero. For a timer task, read the logs of the mains for the scheduling error. For a durable task, check its row in `scheduled_job`.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(min by (task, mode) (n8n_system_task_scheduled{task=~\"$task\", instance=~\"$instance\"}) == 0) or vector(0)",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed Runs",
      "description": "Runs that failed in the selected time range. A run that stops at shutdown is not a failure.\n\nBad when: above zero. Find the task on Failed Runs per Task, then read its error in the logs.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(n8n_system_task_run_duration_seconds_count{task=~\"$task\", instance=~\"$instance\", result=\"failure\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tasks Reporting",
      "description": "System tasks that the mains report now.\n\nBad when: lower than usual. A task that is missing from this count is not monitored.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (task) (n8n_system_task_info{task=~\"$task\", instance=~\"$instance\"})) or vector(0)",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Tasks",
      "description": "One row for each system task, sorted with the latest task first.\n\n* Runs on: the durable scheduler, a timer on the leader main, or a timer on every instance.\n* Last success: the most recent success on any main in the last 2 days. A restart does not reset it.\n* Late factor: last success age divided by the interval. 1 is normal. 2 or more means the task missed a run.\n* Runs and Failures: counts in the selected time range. A daily task often shows 0 runs, so read Last success first.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (task, mode) (n8n_system_task_info{task=~\"$task\", instance=~\"$instance\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "max by (task) (n8n_system_task_interval_seconds{task=~\"$task\", instance=~\"$instance\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "time() - max by (task) (max_over_time(n8n_system_task_last_success_timestamp_seconds{task=~\"$task\", instance=~\"$instance\"}[2d]))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "((time() - max by (task) (max_over_time(n8n_system_task_last_success_timestamp_seconds{task=~\"$task\", instance=~\"$instance\"}[2d]))) / max by (task) (n8n_system_task_interval_seconds{task=~\"$task\", instance=~\"$instance\"})) or on (task) ((max by (task) (n8n_system_task_info{task=~\"$task\", instance=~\"$instance\"}) unless on (task) max by (task) (max_over_time(n8n_system_task_last_success_timestamp_seconds{task=~\"$task\", instance=~\"$instance\"}[2d]))) * 0 + 1000000000)",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "sum by (task) (increase(n8n_system_task_run_duration_seconds_count{task=~\"$task\", instance=~\"$instance\", result=\"success\"}[$__range])) or on (task) (max by (task) (n8n_system_task_info{task=~\"$task\", instance=~\"$instance\"}) * 0)",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "sum by (task) (increase(n8n_system_task_run_duration_seconds_count{task=~\"$task\", instance=~\"$instance\", result=\"failure\"}[$__range])) or on (task) (max by (task) (n8n_system_task_info{task=~\"$task\", instance=~\"$instance\"}) * 0)",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "G",
          "expr": "min by (task) (n8n_system_task_scheduled{task=~\"$task\", instance=~\"$instance\"})",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "indexByName": {
              "task": 0,
              "mode": 1,
              "Value #G": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7
            },
            "renameByName": {
              "task": "Task",
              "mode": "Runs on",
              "Value #G": "Scheduled",
              "Value #B": "Interval",
              "Value #C": "Last success",
              "Value #D": "Late factor",
              "Value #E": "Runs",
              "Value #F": "Failures"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Task"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Runs on"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "durable": {
                        "text": "Durable scheduler",
                        "color": "blue",
                        "index": 0
                      },
                      "leader_timer": {
                        "text": "Leader timer",
                        "color": "text",
                        "index": 1
                      },
                      "in_memory": {
                        "text": "Leader timer",
                        "color": "text",
                        "index": 2
                      },
                      "instance_timer": {
                        "text": "Every instance",
                        "color": "text",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Scheduled"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Yes",
                        "color": "transparent",
                        "index": 0
                      },
                      "0": {
                        "text": "No",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Interval"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last success"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "None in 2 days",
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Late factor"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 2
                    },
                    {
                      "color": "red",
                      "value": 3
                    }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "range",
                    "options": {
                      "from": 1000000000.0,
                      "to": null,
                      "result": {
                        "text": "No success",
                        "color": "red"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Runs"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failures"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Late factor",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Failed Runs per Task",
      "description": "Failed runs in each interval, by task. The chart stays empty while every task succeeds.\n\nBad when: one task fails again and again. Read the error in the logs of the main that ran it.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          },
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task) (increase(n8n_system_task_run_duration_seconds_count{task=~\"$task\", instance=~\"$instance\", result=\"failure\"}[$__interval])) > 0",
          "legendFormat": "{{task}}",
          "interval": "1m"
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Troubleshooting",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 8,
          "type": "timeseries",
          "title": "Run Duration p95",
          "description": "How long runs take, by task.\n\nBad when: p95 is near the interval of the task. The next run then overlaps or is skipped.",
          "gridPos": {
            "x": 0,
            "y": 31,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "min": 0,
              "custom": {
                "lineWidth": 2,
                "fillOpacity": 10,
                "spanNulls": false,
                "showPoints": "never"
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "histogram_quantile(0.95, sum by (le, task) (rate(n8n_system_task_run_duration_seconds_bucket{task=~\"$task\", instance=~\"$instance\"}[$__rate_interval])))",
              "legendFormat": "{{task}}"
            }
          ]
        },
        {
          "id": 9,
          "type": "timeseries",
          "title": "Runs in Progress",
          "description": "Runs that are in progress now, by task.\n\nBad when: a task stays above zero for longer than its p95 duration. That run is stuck.",
          "gridPos": {
            "x": 12,
            "y": 31,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "min": 0,
              "custom": {
                "lineWidth": 2,
                "fillOpacity": 10,
                "spanNulls": false,
                "showPoints": "never"
              },
              "decimals": 0
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (task) (n8n_system_task_runs_in_flight{task=~\"$task\", instance=~\"$instance\"}) > 0",
              "legendFormat": "{{task}}"
            }
          ]
        },
        {
          "id": 10,
          "type": "timeseries",
          "title": "Skipped Runs (timers only)",
          "description": "Runs that came due on a timer but did not start, by task and reason. `overlap`: the previous run was still in progress. `provisioned_elsewhere`: the durable scheduler runs the task. `aborted` and `coalesced` are harmless. Durable tasks never appear here.\n\nBad when: `overlap` is steady. The runs take longer than the interval.",
          "gridPos": {
            "x": 0,
            "y": 39,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "min": 0,
              "custom": {
                "drawStyle": "bars",
                "fillOpacity": 80,
                "lineWidth": 1,
                "stacking": {
                  "mode": "normal"
                }
              },
              "decimals": 0
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (task, reason) (increase(n8n_system_task_runs_skipped_total{task=~\"$task\", instance=~\"$instance\"}[$__interval])) > 0",
              "legendFormat": "{{task}} · {{reason}}",
              "interval": "1m"
            }
          ]
        },
        {
          "id": 11,
          "type": "timeseries",
          "title": "Retries (timers only)",
          "description": "Extra attempts after a failed run on a timer, by task. Durable retries are on the Durable Scheduler dashboard.\n\nBad when: retries rise together with Failed Runs per Task.",
          "gridPos": {
            "x": 12,
            "y": 39,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "min": 0,
              "custom": {
                "drawStyle": "bars",
                "fillOpacity": 80,
                "lineWidth": 1,
                "stacking": {
                  "mode": "normal"
                }
              },
              "decimals": 0
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (task) (increase(n8n_system_task_retries_total{task=~\"$task\", instance=~\"$instance\"}[$__interval])) > 0",
              "legendFormat": "{{task}}",
              "interval": "1m"
